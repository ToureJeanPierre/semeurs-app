# Copier ce fichier en .env.local pour travailler en local.
# En ligne, ces valeurs se collent dans Vercel → Settings → Environment Variables.
# Ne jamais mettre les vraies valeurs secrètes dans Git.

# Supabase → Project Settings → API Keys (public, sans danger)
NEXT_PUBLIC_SUPABASE_URL=https://mqarxjlmuvmpxnccpnrf.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Project Settings → API Keys → Secret key (SECRET : serveur uniquement)
SUPABASE_SECRET_KEY=sb_secret_xxx

# Chaîne aléatoire d'au moins 32 caractères (SECRET) : signe le verrou de l'application
APP_LOCK_SECRET=remplacer-par-une-longue-chaine-aleatoire

# Facultatif : minutes d'inactivité avant de redemander l'empreinte ou le schéma (30 par défaut)
# APP_LOCK_IDLE_MINUTES=30
